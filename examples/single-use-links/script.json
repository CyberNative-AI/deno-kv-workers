{
  "normalize": [
    { "pattern": "[0-9a-f]{10}", "replace": "<id>" },
    { "pattern": "\\d{4}-\\d\\d-\\d\\dT[\\d:.]+Z", "replace": "<time>" },
    { "pattern": "\"cursor\":\"[^\"]+\"", "replace": "\"cursor\":\"<cursor>\"" }
  ],
  "steps": [
    { "name": "create link 1", "method": "POST", "path": "/links", "json": { "target": "https://example.com/1" }, "save": { "l1": "id" } },
    { "name": "create link 2", "method": "POST", "path": "/links", "json": { "target": "https://example.com/2" }, "save": { "l2": "id" } },
    { "name": "create link 3", "method": "POST", "path": "/links", "json": { "target": "https://example.com/3" }, "save": { "l3": "id" } },
    { "name": "create link 4", "method": "POST", "path": "/links", "json": { "target": "https://example.com/4" }, "save": { "l4": "id" } },
    { "name": "create link 5", "method": "POST", "path": "/links", "json": { "target": "https://example.com/5" }, "save": { "l5": "id" } },
    { "name": "create link 6", "method": "POST", "path": "/links", "json": { "target": "https://example.com/6" }, "save": { "l6": "id" } },
    { "name": "create link 7", "method": "POST", "path": "/links", "json": { "target": "https://example.com/7" }, "save": { "l7": "id" } },
    { "name": "create link 8", "method": "POST", "path": "/links", "json": { "target": "https://example.com/8" }, "save": { "l8": "id" } },
    {
      "name": "create link to delete",
      "method": "POST",
      "path": "/links",
      "json": { "target": "https://example.com/deleted" },
      "save": { "del": "id" }
    },
    { "name": "20 concurrent redeems of link 1", "method": "GET", "path": "/r/{{l1}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 2", "method": "GET", "path": "/r/{{l2}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 3", "method": "GET", "path": "/r/{{l3}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 4", "method": "GET", "path": "/r/{{l4}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 5", "method": "GET", "path": "/r/{{l5}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 6", "method": "GET", "path": "/r/{{l6}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 7", "method": "GET", "path": "/r/{{l7}}", "concurrent": 20 },
    { "name": "20 concurrent redeems of link 8", "method": "GET", "path": "/r/{{l8}}", "concurrent": 20 },
    { "name": "redeem link 1 again", "method": "GET", "path": "/r/{{l1}}" },
    { "name": "delete a link", "method": "DELETE", "path": "/links/{{del}}" },
    { "name": "redeem the deleted link", "method": "GET", "path": "/r/{{del}}" },
    { "name": "list first page", "method": "GET", "path": "/links?limit=1" },
    { "name": "stats", "method": "GET", "path": "/stats" }
  ]
}
